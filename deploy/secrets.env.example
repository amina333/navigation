# ══════════════════════════════════════════════════════════════
# Secrets Kubernetes (secret « app-secrets », namespace skyguide)
# Copier en deploy/secrets.env SUR LA VM puis remplir.
# deploy/secrets.env est ignoré par Git : ne jamais le committer (dépôt public).
# ══════════════════════════════════════════════════════════════

# ── Base de données ──
DB_HOST=skyguide-postgres
DB_PORT=5432
DB_NAME=navigation_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── Sécurité ──
JWT_SECRET=change-me-base64-64-octets-minimum
ADMIN_PASSWORD=Admin@1234

# ── SkyAI (facultatif : sans clé, moteur métier interne) ──
OPENAI_API_KEY=

# ── Envoi des e-mails (Gmail + mot de passe d'application) ──
# L'expéditeur doit être une adresse @gmail.com (sinon spam / rejet : SPF/DMARC).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=motdepasseapplication16
MAIL_FROM=votre.adresse@gmail.com

# Adresse publique de l'application (liens dans les e-mails)
FRONTEND_URL=http://20.199.138.169:32385
