FROM eclipse-temurin:17-jdk AS build
WORKDIR /app
COPY navigation-backend/mvnw .
COPY navigation-backend/.mvn .mvn
COPY navigation-backend/pom.xml .
# mvnw often loses its execute bit when the repo is cloned from Windows
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B
COPY navigation-backend/src src
RUN ./mvnw package -DskipTests -B

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
