FROM node:18-alpine AS build
WORKDIR /app
COPY navigation-frontend/package.json navigation-frontend/package-lock.json* ./
RUN npm ci
COPY navigation-frontend/ .
RUN npx ng build --configuration=production

FROM nginx:alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/navigation-frontend/browser /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
